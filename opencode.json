{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@opencode_weave/weave"
  ],
  "model": "llama/qwenopus3.6-27b",
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp Server",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "includeUsage": true
      },
      "models": {
        "qwenopus3.6-27b": {
          "name": "Qwopus3.6",
          "limit": {
            "context": 75000,
            "output": 50000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "search tools": {
      "type": "remote",
      "url": "http://localhost:3100/mcp",
      "enabled": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": {
      "*": "allow"
    },
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}